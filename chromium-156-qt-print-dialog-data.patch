+void PrintDialogQt::RememberJobOptions(const PrintSettings& settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  const std::string printer_name = base::UTF16ToUTF8(settings.device_name());
+  if (!printer_name.empty())
+    printer_name_ = printer_name;
+  copies_ = std::max(settings.copies(), 1);
+  collate_ = settings.collate();
+  landscape_ = settings.landscape();
+  duplex_mode_ = settings.duplex_mode();
+  color_model_ = settings.color();
+}
+
+void PrintDialogQt::ApplyQtFallbacks(const qt::PrintingSettings& qt_settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (printer_name_.empty() && qt_settings.printer_name.c_str())
+    printer_name_ = qt_settings.printer_name.c_str();
+  if (copies_ <= 0)
+    copies_ = std::max(qt_settings.copies, 1);
+}
+
+void PrintDialogQt::SetLinuxPrintDialogData(PrintSettings* settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+#if BUILDFLAG(ENABLE_OOP_PRINTING_NO_OOP_BASIC_PRINT_DIALOG)
+  if (printer_name_.empty())
+    return;
+
+  // Qt has no GTK keyfile. Empty strings still satisfy FindString(), and the
+  // dict size must be exactly 3. Do not add or omit a key.
+  base::DictValue dialog_data;
+  dialog_data.Set(printing::kLinuxSystemPrintDialogDataPrinter, printer_name_);
+  dialog_data.Set(printing::kLinuxSystemPrintDialogDataPrintSettings,
+                  std::string());
+  dialog_data.Set(printing::kLinuxSystemPrintDialogDataPageSetup,
+                  std::string());
+  settings->set_system_print_dialog_data(std::move(dialog_data));
+#else
+  (void)settings;
+#endif
+}
+
+void PrintDialogQt::CommitPrintSettings(
+    std::unique_ptr<PrintSettings> settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!context_)
+    return;
+
+  if (!printer_name_.empty())
+    settings->set_device_name(base::UTF8ToUTF16(printer_name_));
+  settings->set_copies(copies_);
+  settings->set_collate(collate_);
+  settings->set_duplex_mode(duplex_mode_);
+  settings->set_color(color_model_);
+  SetLinuxPrintDialogData(settings.get());
+  context_->InitWithSettings(std::move(settings));
+}
+
+void PrintDialogQt::InitPrintSettings(std::unique_ptr<PrintSettings> settings,
+                                      const qt::PrintingSettings* qt_settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!context_)
+    return;
+
+  if (qt_settings) {
+    ApplyQtFallbacks(*qt_settings);
+    InitPrintSettingsQt(*qt_settings, settings.get());
+  }
+  CommitPrintSettings(std::move(settings));
+}
