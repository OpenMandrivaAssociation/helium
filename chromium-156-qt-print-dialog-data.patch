+// Explicit ints from the shim, not QPrinter::DuplexMode values.
+// 0 = simplex, 1 = auto/unknown, 2 = long edge, 3 = short edge.
+printing::mojom::DuplexMode DuplexModeFromQt(int qt_duplex) {
+  switch (qt_duplex) {
+    case 2:
+      return printing::mojom::DuplexMode::kLongEdge;
+    case 3:
+      return printing::mojom::DuplexMode::kShortEdge;
+    case 0:
+      return printing::mojom::DuplexMode::kSimplex;
+    default:
+      return printing::mojom::DuplexMode::kUnknownDuplexMode;
+  }
+}
+
+printing::mojom::ColorModel ColorModelFromQt(bool color) {
+  // Coarse stand-in for a system-dialog boolean. Print preview passes the
+  // printer's real ColorModel through and must not use this mapping.
+  return color ? printing::mojom::ColorModel::kRGB
+               : printing::mojom::ColorModel::kGray;
