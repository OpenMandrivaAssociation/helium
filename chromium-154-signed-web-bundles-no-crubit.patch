@@ -0,0 +1,283 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// System Rust does not build Crubit cpp_api_from_rust bindings. cxx shared
+// structs cannot hold the parser's borrowed strings and byte slices, so these
+// wrappers copy them into owned data.
+
+#[cxx::bridge(namespace = "web_package::rust")]
+mod bridge {
+    struct FfiU64 {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        value: u64,
+    }
+
+    struct FfiMagic {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        section_lengths_len: u64,
+        next_read_offset: u64,
+        next_read_length: u64,
+    }
+
+    struct FfiSection {
+        name: String,
+        offset: u64,
+        length: u64,
+    }
+
+    struct FfiBundleHeader {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        metadata_sections: Vec<FfiSection>,
+        responses_offset: u64,
+        responses_length: u64,
+    }
+
+    struct FfiIndexEntry {
+        url: String,
+        offset: u64,
+        length: u64,
+    }
+
+    struct FfiIndex {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        entries: Vec<FfiIndexEntry>,
+    }
+
+    struct FfiString {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        value: String,
+    }
+
+    struct FfiBool {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        value: bool,
+    }
+
+    struct FfiHeader {
+        name: Vec<u8>,
+        value: Vec<u8>,
+    }
+
+    struct FfiResponse {
+        ok: bool,
+        is_version_error: bool,
+        message: String,
+        needs_more_data: bool,
+        required_buffer_size: u64,
+        response_code: i32,
+        headers: Vec<FfiHeader>,
+        payload_offset: u64,
+        payload_length: u64,
+    }
+
+    extern "Rust" {
+        fn parse_trailing_length(data: &[u8], file_length: u64) -> FfiU64;
+        fn parse_magic_and_version(data: &[u8], current_offset: u64) -> FfiMagic;
+        fn parse_bundle_header(
+            data: &[u8],
+            section_lengths_len: u64,
+            current_offset: u64,
+        ) -> FfiBundleHeader;
+        fn parse_index_section(
+            data: &[u8],
+            responses_offset: u64,
+            responses_length: u64,
+        ) -> FfiIndex;
+        fn parse_critical_section(data: &[u8]) -> FfiBool;
+        fn parse_primary_section(data: &[u8]) -> FfiString;
+        fn parse_response(data: &[u8], response_offset: u64, response_length: u64) -> FfiResponse;
+    }
+}
+
+fn message_of(err: &crate::types::ParseError) -> String {
+    err.message.to_owned()
+}
+
+fn parse_trailing_length(data: &[u8], file_length: u64) -> bridge::FfiU64 {
+    match crate::parser::parse_trailing_length(data, file_length) {
+        Ok(value) => bridge::FfiU64 {
+            ok: true,
+            is_version_error: false,
+            message: String::new(),
+            value,
+        },
+        Err(err) => bridge::FfiU64 {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            value: 0,
+        },
+    }
+}
+
+fn parse_magic_and_version(data: &[u8], current_offset: u64) -> bridge::FfiMagic {
+    match crate::parser::parse_magic_and_version(data, current_offset) {
+        Ok(parsed) => bridge::FfiMagic {
+            ok: true,
+            is_version_error: false,
+            message: String::new(),
+            section_lengths_len: parsed.section_lengths_len,
+            next_read_offset: parsed.next_read_offset,
+            next_read_length: parsed.next_read_length,
+        },
+        Err(err) => bridge::FfiMagic {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            section_lengths_len: 0,
+            next_read_offset: 0,
+            next_read_length: 0,
+        },
+    }
+}
+
+fn parse_bundle_header(
+    data: &[u8],
+    section_lengths_len: u64,
+    current_offset: u64,
+) -> bridge::FfiBundleHeader {
+    match crate::parser::parse_bundle_header(data, section_lengths_len, current_offset) {
+        Ok(parsed) => {
+            let metadata_sections: Vec<bridge::FfiSection> = parsed
+                .metadata_sections
+                .into_iter()
+                .map(|section| bridge::FfiSection {
+                    name: section.name,
+                    offset: section.offset,
+                    length: section.length,
+                })
+                .collect();
+            bridge::FfiBundleHeader {
+                ok: true,
+                is_version_error: false,
+                message: String::new(),
+                metadata_sections,
+                responses_offset: parsed.responses_offset,
+                responses_length: parsed.responses_length,
+            }
+        }
+        Err(err) => bridge::FfiBundleHeader {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            metadata_sections: Vec::new(),
+            responses_offset: 0,
+            responses_length: 0,
+        },
+    }
+}
+
+fn parse_index_section(
+    data: &[u8],
+    responses_offset: u64,
+    responses_length: u64,
+) -> bridge::FfiIndex {
+    match crate::parser::parse_index_section(data, responses_offset, responses_length) {
+        Ok(parsed) => {
+            let entries: Vec<bridge::FfiIndexEntry> = parsed
+                .into_iter()
+                .map(|entry| bridge::FfiIndexEntry {
+                    url: entry.url.to_owned(),
+                    offset: entry.offset,
+                    length: entry.length,
+                })
+                .collect();
+            bridge::FfiIndex {
+                ok: true,
+                is_version_error: false,
+                message: String::new(),
+                entries,
+            }
+        }
+        Err(err) => bridge::FfiIndex {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            entries: Vec::new(),
+        },
+    }
+}
+
+fn parse_critical_section(data: &[u8]) -> bridge::FfiBool {
+    match crate::parser::parse_critical_section(data) {
+        Ok(value) => bridge::FfiBool {
+            ok: true,
+            is_version_error: false,
+            message: String::new(),
+            value,
+        },
+        Err(err) => bridge::FfiBool {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            value: false,
+        },
+    }
+}
+
+fn parse_primary_section(data: &[u8]) -> bridge::FfiString {
+    match crate::parser::parse_primary_section(data) {
+        Ok(url) => bridge::FfiString {
+            ok: true,
+            is_version_error: false,
+            message: String::new(),
+            value: url.to_owned(),
+        },
+        Err(err) => bridge::FfiString {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            value: String::new(),
+        },
+    }
+}
+
+fn parse_response(data: &[u8], response_offset: u64, response_length: u64) -> bridge::FfiResponse {
+    match crate::parser::parse_response(data, response_offset, response_length) {
+        Ok(parsed) => {
+            let headers: Vec<bridge::FfiHeader> = parsed
+                .headers
+                .into_iter()
+                .map(|header| bridge::FfiHeader {
+                    name: header.name.to_vec(),
+                    value: header.value.to_vec(),
+                })
+                .collect();
+            bridge::FfiResponse {
+                ok: true,
+                is_version_error: false,
+                message: String::new(),
+                needs_more_data: parsed.needs_more_data,
+                required_buffer_size: parsed.required_buffer_size,
+                response_code: parsed.response_code,
+                headers,
+                payload_offset: parsed.payload_offset,
+                payload_length: parsed.payload_length,
+            }
+        }
+        Err(err) => bridge::FfiResponse {
+            ok: false,
+            is_version_error: err.is_version_error,
+            message: message_of(&err),
+            needs_more_data: false,
+            required_buffer_size: 0,
+            response_code: 0,
+            headers: Vec::new(),
+            payload_offset: 0,
+            payload_length: 0,
+        },
+    }
+}
