+void CefBrowserContentsDelegate::SetFindHelperObservation(
+    content::WebContents* contents) {
+  auto* helper = contents ? find_in_page::FindTabHelper::FromWebContents(contents)
+                          : nullptr;
+  if (helper == observed_find_helper_) {
+    return;
+  }
+  if (observed_find_helper_) {
+    observed_find_helper_->RemoveObserver(this);
+    observed_find_helper_ = nullptr;
+  }
+  if (helper) {
+    helper->AddObserver(this);
+    observed_find_helper_ = helper;
+  }
