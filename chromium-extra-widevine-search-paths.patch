Chromium 156 registers a Widevine CDM only from a directory that contains
manifest.json. CreateCdmInfoFromWidevineDirectory also requires the library
under _platform_specific/linux_<arch>/. A bare libwidevinecdm.so path cannot
be returned from DIR_BUNDLED_WIDEVINE_CDM.

Search the usual system and per-user directories after the bundled and
component-updater lookups miss. Accept either Chrome's platform subdirectory
layout or a flat directory with manifest.json next to libwidevinecdm.so.
--- a/chrome/common/media/cdm_registration.cc
+++ b/chrome/common/media/cdm_registration.cc
@@ -157,8 +157,64 @@ std::unique_ptr<content::CdmInfo> GetHintedWidevine() {
 }
 #endif  // (BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT) && (BUILDFLAG(IS_LINUX) ||
         // BUILDFLAG(IS_CHROMEOS)))
 
+#if (BUILDFLAG(BUNDLE_WIDEVINE_CDM) ||            \
+     BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)) && \
+    (BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS))
+// Distro installers and other browsers ship Widevine outside the bundled
+// component directory. Chrome's layout is <dir>/manifest.json plus
+// <dir>/_platform_specific/linux_<arch>/libwidevinecdm.so. Some packages put
+// manifest.json beside libwidevinecdm.so instead.
+std::unique_ptr<content::CdmInfo> CreateCdmInfoFromWidevineDirectoryOrFlat(
+    const base::FilePath& dir) {
+  if (auto info = CreateCdmInfoFromWidevineDirectory(dir)) {
+    return info;
+  }
+  base::FilePath library = dir.Append(FILE_PATH_LITERAL("libwidevinecdm.so"));
+  base::FilePath manifest = dir.Append(FILE_PATH_LITERAL("manifest.json"));
+  if (!base::PathExists(library)) {
+    return nullptr;
+  }
+  media::CdmCapability capability;
+  if (!ParseCdmManifestFromPath(manifest, &capability)) {
+    return nullptr;
+  }
+  return CreateWidevineCdmInfo(library, std::move(capability));
+}
+
+std::unique_ptr<content::CdmInfo> GetSystemWidevine() {
+  const char* const kDirs[] = {
+      "/opt/widevine",
+      "/opt/google/chrome/WidevineCdm",
+      "/opt/google/chrome-beta/WidevineCdm",
+      "/opt/google/chrome-unstable/WidevineCdm",
+      "/opt/microsoft/msedge/WidevineCdm",
+      "/opt/microsoft/msedge-dev/WidevineCdm",
+      "/opt/brave.com/brave/WidevineCdm",
+  };
+  for (const char* path : kDirs) {
+    if (auto info =
+            CreateCdmInfoFromWidevineDirectoryOrFlat(base::FilePath(path))) {
+      return info;
+    }
+  }
+  base::FilePath home;
+  if (base::PathService::Get(base::DIR_HOME, &home)) {
+    const base::FilePath home_dirs[] = {
+        home.Append(FILE_PATH_LITERAL(".local/lib")),
+        home.Append(FILE_PATH_LITERAL(".local/lib/WidevineCdm")),
+    };
+    for (const auto& dir : home_dirs) {
+      if (auto info = CreateCdmInfoFromWidevineDirectoryOrFlat(dir)) {
+        return info;
+      }
+    }
+  }
+  return nullptr;
+}
+#endif
