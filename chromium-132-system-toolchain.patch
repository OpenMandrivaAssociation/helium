--- a/build/rust/gni_impl/libclang_args.gni
+++ b/build/rust/gni_impl/libclang_args.gni
@@ -38,7 +38,7 @@
 # system headers to be found.
 _libclang_extra_args += [
   "-resource-dir",
-  rebase_path(clang_base_path + "/lib/clang/" + clang_version, root_build_dir),
+  rebase_path(clang_base_path + "/lib64/clang/" + clang_version, root_build_dir),
 ]
 
 if (is_win) {
--- a/v8/BUILD.gn
+++ b/v8/BUILD.gn
@@ -2511,7 +2511,7 @@
 
   # The clang toolchain's resource dir contains builting headers
   # include/{stddef.h,stdarg.h,...}.
-  _metagen_clang_resource_dir = "$clang_base_path/lib/clang/$clang_version"
+  _metagen_clang_resource_dir = "$clang_base_path/lib64/clang/$clang_version"
 
   # The headers are parsed with v8_base_without_compiler's flags.
   _metagen_flags_target = ":v8_base_without_compiler"
